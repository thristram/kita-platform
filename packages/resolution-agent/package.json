{
  "name": "@kita/resolution-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "kita-resolution-agent": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "agent:build": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts worker",
    "agent:dev": "npm run dev",
    "worker": "node dist/cli.js worker",
    "agent:worker": "npm run worker",
    "doctor": "node dist/cli.js doctor",
    "test": "node --import tsx --test test/*.test.ts",
    "agent:test": "npm test"
  },
  "dependencies": {
    "@kita/contracts": "0.1.0",
    "@kita/evidence-pipeline": "0.1.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
