{
  "name": "@kita/anime-knowledge-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "kita-anime-knowledge": "./dist/cli.js",
    "kita-anime-knowledge-mcp": "./dist/mcp.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/cli.ts serve",
    "start": "node dist/cli.js serve",
    "mcp": "node dist/mcp.js",
    "import:scan": "node dist/cli.js import:scan",
    "doctor": "node dist/cli.js doctor",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@kita/contracts": "0.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
