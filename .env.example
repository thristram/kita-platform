# Web/API pooled connection; crawler/migrations use the direct connection below.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
NEON_BRANCH=production

# Operator Console: standard OIDC; initially register KitaCon in thristram-auth.
# Issuer must exactly match the provider discovery document's issuer.
KITA_AUTH_ISSUER=http://localhost:3000/api/auth
KITA_AUTH_CLIENT_ID=replace-with-registered-client-id
KITA_AUTH_CLIENT_SECRET=replace-with-registered-client-secret
# Temporary compatibility setting for thristram-auth 1.6.x; see docs/runbooks/console-auth.md.
KITA_AUTH_TOKEN_AUTH_METHOD=client_secret_post
KITA_APP_URL=http://localhost:3009
# Random 32+ characters; rotate to invalidate all Console sessions.
KITA_SESSION_SECRET=replace-with-at-least-32-random-characters

# Local development only. Production must use r2.
CRAWLER_ARTIFACT_MODE=local
CRAWLER_ARTIFACT_ROOT=var/crawler/artifacts
CRAWLER_WORKER_NAME=kita-local-crawler
CRAWLER_USER_AGENT=KitaConCrawler/0.1 (+https://kitacon.app/crawler-policy)
CRAWLER_DEFAULT_MAX_DEPTH=3
CRAWLER_DEFAULT_MAX_PAGES=100
CRAWLER_DEFAULT_CONCURRENCY=4
CRAWLER_DEFAULT_TIMEOUT_SECONDS=30

# Required by both the production crawler and web/API deployment.
R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
# R2_ENDPOINT is also accepted; R2_ENDPOINT_URL is retained for boto3 conventions.
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_RAW_BUCKET=kitacon-raw
R2_MEDIA_BUCKET=kitacon-media

# Shared by the trusted web/API runtime and packages/resolution-agent.
# Use a random value with at least 32 characters; do not commit the real token.
RESOLUTION_AGENT_TOKEN=replace-with-a-long-random-resolution-agent-token
